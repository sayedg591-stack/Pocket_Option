javascript:(() => {

/* =========================
   CLEAN OLD DEMO
========================= */
document.getElementById("shadin-demo")?.remove();
document.getElementById("shadin-demo-style")?.remove();


/* =========================
   STYLE FOR POPUP
========================= */
const style = document.createElement("style");
style.id = "shadin-demo-style";

style.textContent = `
#shadin-demo{
  position:fixed;
  inset:0;
  z-index:999999999;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(4px);
  -webkit-backdrop-filter:blur(4px);
  font-family:Arial,sans-serif;
}
#shadin-demo .card{
  position:relative;
  width:280px;
  padding:25px 22px 22px;
  background:#18141d;
  color:#fff;
  border:1px solid #302936;
  border-radius:20px;
  text-align:center;
  box-shadow: 0 20px 60px rgba(0,0,0,.7), 0 0 25px rgba(0,0,0,.25);
  animation:shadinPop .4s cubic-bezier(.2,.8,.2,1);
}
#shadin-demo .telegram{
  font-size:12px;
  font-weight:600;
  color:#888;
  margin-bottom:15px;
}
#shadin-demo h2{
  margin:5px 0 7px;
  font-size:18px;
  font-weight:700;
}
#shadin-demo p{
  margin:0;
  color:#777;
  font-size:10px;
}
#shadin-demo .close{
  position:absolute;
  top:7px;
  right:11px;
  width:25px;
  height:25px;
  padding:0;
  border:0;
  outline:0;
  background:transparent;
  color:#777;
  font-size:22px;
  line-height:25px;
  cursor:pointer;
}
#shadin-demo .close:hover{
  color:#aaa;
}
#shadin-demo .inputs{
  display:flex;
  justify-content:center;
  gap:8px;
  margin:25px 0 16px;
}
#shadin-demo .inputs input{
  width:40px;
  height:42px;
  padding:0;
  background:#211d27;
  border:1px solid #39333f;
  border-radius:9px;
  outline:none;
  color:#fff;
  text-align:center;
  font-size:20px;
  font-weight:600;
  caret-color:#e7473f;
  transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
}
#shadin-demo .inputs input:focus{
  border-color:#e7473f;
  box-shadow:0 0 10px rgba(231,71,63,.35);
}
#shadin-demo .inputs input.success{
  border-color:#0faf59!important;
  box-shadow:0 0 13px rgba(15,175,89,.55)!important;
  color:#0faf59;
  transform:scale(1.04);
}
#shadin-demo .message{
  height:16px;
  font-size:11px;
  font-weight:600;
  transition:opacity .2s ease;
}
#shadin-demo .card.shake{
  animation:shadinShake .32s ease;
}
#shadin-demo .card.success{
  box-shadow: 0 20px 60px rgba(0,0,0,.7), 0 0 30px rgba(15,175,89,.35);
}
#shadin-demo .card.hide{
  animation:shadinHide .45s ease forwards;
}
@keyframes shadinPop{
  0%{ opacity:0; transform:scale(.72) translateY(12px); }
  100%{ opacity:1; transform:scale(1) translateY(0); }
}
@keyframes shadinShake{
  0%,100%{ transform:translateX(0); }
  20%{ transform:translateX(-8px); }
  40%{ transform:translateX(8px); }
  60%{ transform:translateX(-6px); }
  80%{ transform:translateX(5px); }
}
@keyframes shadinHide{
  0%{ opacity:1; transform:scale(1); }
  100%{ opacity:0; transform:scale(1.12); }
}
`;

document.head.appendChild(style);


/* =========================
   POPUP HTML
========================= */
const popup = document.createElement("div");
popup.id = "shadin-demo";

popup.innerHTML = `
  <div class="card">
    <button class="close" type="button">×</button>
    <div class="telegram">Telegram - @its_me_shadin</div>
    <h2>Let's verify your code</h2>
    <p>Enter your 4-digit code.</p>
    <div class="inputs">
      <input type="text" maxlength="1" inputmode="numeric" autocomplete="off">
      <input type="text" maxlength="1" inputmode="numeric" autocomplete="off">
      <input type="text" maxlength="1" inputmode="numeric" autocomplete="off">
      <input type="text" maxlength="1" inputmode="numeric" autocomplete="off">
    </div>
    <div class="message"></div>
  </div>
`;

document.body.appendChild(popup);


/* =========================
   ELEMENTS & LOGIC
========================= */
const card = popup.querySelector(".card");
const closeBtn = popup.querySelector(".close");
const message = popup.querySelector(".message");
const inputs = [...popup.querySelectorAll(".inputs input")];

closeBtn.addEventListener("click", e => {
  e.preventDefault();
  e.stopPropagation();
  message.textContent = "Enter the correct code";
  message.style.color = "#888";
});

popup.addEventListener("click", e => {
  if (e.target === popup) {
    e.preventDefault();
    e.stopPropagation();
  }
});

// Bonus Hider Function (Added here)
function hideBonusButton() {
  const bonusBtn = document.querySelector('.h-btn.h-btn--bonus-welcome');
  if (bonusBtn) {
    bonusBtn.style.display = 'none';
  }
}

// Layout Changer Function (Runs after successful verification)
function startLayoutChanger() {
  // Hide bonus button immediately upon success
  hideBonusButton();

  function applyExactLayout() {
    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      null,
      false
    );

    let node;
    while ((node = walker.nextNode())) {
      const text = node.nodeValue.trim();
      const parent = node.parentElement;

      if (!parent) continue;

      if (text.includes('QT Demo USD') || text.includes('QT Demo')) {
        if (!parent.closest('.dropdown-menu-item:nth-child(2)')) {
          node.nodeValue = node.nodeValue.replace(/QT Demo USD|QT Demo/g, 'QT Real');
        }
      }

      if (text.includes('49,906.80') || text.includes('50,000')) {
        if (!parent.closest('.dropdown-menu-item:nth-child(2)')) {
          node.nodeValue = node.nodeValue.replace(/49,906\.80|50,000/g, '5,018.72');
        }
      }

      if (text === '$0' || text === '$0.00') {
        node.nodeValue = '$50,000.00';
      }
    }

    document.querySelectorAll('*').forEach(el => {
      if (el.children.length === 0 && el.textContent.includes('QT Real') && el.textContent.includes('50,000')) {
        el.textContent = el.textContent.replace('QT Real', 'QT Demo');
      }
    });
  
    // Also keep checking for bonus button in case of re-renders
    hideBonusButton();
  }

  applyExactLayout();

  let isMutating = false;
  const observer = new MutationObserver(() => {
    if (isMutating) return;
    isMutating = true;
    applyExactLayout();
    setTimeout(() => { isMutating = false; }, 100);
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
}

// Check Code Logic
function checkCode() {
  if (!inputs.every(input => input.value)) return;

  const code = inputs.map(input => input.value).join("");

  if (code === "2563") {
    inputs.forEach(input => input.classList.add("success"));
    card.classList.add("success");
    message.textContent = "✓ Verified";
    message.style.color = "#0faf59";

    setTimeout(() => {
      card.classList.add("hide");
      setTimeout(() => {
        popup.remove();
        style.remove();
        // Start layout script right after verification success
        startLayoutChanger();
      }, 450);
    }, 550);

  } else {
    card.classList.remove("shake");
    void card.offsetWidth;
    card.classList.add("shake");
    message.textContent = "Wrong code";
    message.style.color = "#e7473f";

    setTimeout(() => {
      inputs.forEach(input => {
        input.value = "";
        input.classList.remove("success");
      });
      message.textContent = "";
      inputs[0].focus();
    }, 400);
  }
}

// Input Handlers
inputs.forEach((input, index) => {
  input.addEventListener("input", () => {
    input.value = input.value.replace(/[^0-9]/g, "");
    if (input.value && index < inputs.length - 1) {
      inputs[index + 1].focus();
    }
    checkCode();
  });

  input.addEventListener("keydown", e => {
    if (e.key === "Backspace" && !input.value && index > 0) {
      inputs[index - 1].focus();
    }
    if (e.key === "ArrowLeft" && index > 0) {
      inputs[index - 1].focus();
    }
    if (e.key === "ArrowRight" && index < inputs.length - 1) {
      inputs[index + 1].focus();
    }
  });
});

inputs[0].addEventListener("paste", e => {
  e.preventDefault();
  const pasted = (e.clipboardData || window.clipboardData)
    .getData("text")
    .replace(/\D/g, "")
    .slice(0, 4);

  pasted.split("").forEach((digit, i) => {
    if (inputs[i]) inputs[i].value = digit;
  });

  if (pasted.length === 4) {
    inputs[3].focus();
    checkCode();
  } else {
    inputs[Math.min(pasted.length, 3)].focus();
  }
});

inputs[0].focus();

})();
